# Server and optional desktop config. Copy this file to .env on first setup.

# Required: your OpenAI API key, used by the ingestion and query agents.
OPENAI_API_KEY=your-openai-api-key

# Optional: inexpensive model with structured output and tool calling.
OPENAI_MODEL=gpt-4.1-nano

# Optional: defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./sra.db

# Phase 2 client settings (learning stubs must be implemented before use).
# The desktop client needs no OpenAI/LangSmith/database/OAuth credentials.
# Server origin or deployment prefix, without /api/v1:
API_BASE_URL=http://127.0.0.1:8000
# Local faster-whisper model; first real use can download weights.
WHISPER_MODEL_SIZE=base
# macOS global hotkey, read at startup:
HOTKEY_COMBO=<ctrl>+<alt>+r

# Optional: trace ingestion/chat graphs, model calls, and tools in LangSmith.
# Set true and supply your LangSmith key to enable uploads (includes study content).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spaced-repetition-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set for an API key linked to multiple workspaces:
# LANGSMITH_WORKSPACE_ID=your-workspace-id
