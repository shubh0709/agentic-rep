# Server and optional desktop config. Copy this file to .env on first setup.

# Required: your OpenAI API key, used by the ingestion and query agents.
OPENAI_API_KEY=your-openai-api-key

# Optional: inexpensive model with structured output and tool calling.
OPENAI_MODEL=gpt-4.1-nano

# Optional: defaults to a local SQLite file if unset. Back up an existing file
# before `alembic upgrade head`; see README.md for the legacy-user procedure.
DATABASE_URL=sqlite:///./sra.db

# Server-only Google OAuth. Register the callback URL exactly in Google Cloud.
# Keep the client secret and signing secret out of desktop/client environments.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/api/v1/auth/google/callback
# Generate a high-entropy value (for example: openssl rand -hex 32).
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-bytes
AUTH_CREDENTIAL_TTL_SECONDS=3600
# Long-lived refresh token (SRA-306). Survives access-token expiry so an active
# browser tab or running desktop client does not see a forced Google re-login.
# Rotated on every exchange; a stolen value is invalidated by the next legitimate
# refresh. 604800 seconds = 7 days.
AUTH_REFRESH_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
DESKTOP_COMPLETION_TTL_SECONDS=60
# False is allowed only for localhost HTTP development. Deployments must use
# HTTPS and set this true so browsers never send the cookie over plain HTTP.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_WEB_REDIRECT_URL=/

# In-process token buckets: burst capacity and sustained tokens per second.
# All protected routes share one bucket per user; auth entry points share one per IP.
RATE_LIMIT_AUTHENTICATED_CAPACITY=60
RATE_LIMIT_AUTHENTICATED_REFILL_PER_SECOND=1.0
RATE_LIMIT_ANONYMOUS_CAPACITY=20
RATE_LIMIT_ANONYMOUS_REFILL_PER_SECOND=0.2
# Must be at least capacity / refill rate for BOTH policies. Idle keys expire.
RATE_LIMIT_IDLE_TTL_SECONDS=3600

# Client settings (text capture is implemented; audio/hotkey exercises follow).
# The desktop client needs no OpenAI/LangSmith/database/OAuth credentials.
# Server origin or deployment prefix, without /api/v1:
API_BASE_URL=http://127.0.0.1:8000
# Local faster-whisper model; first real use can download weights.
WHISPER_MODEL_SIZE=base
# macOS global hotkey, read at startup:
HOTKEY_COMBO=<ctrl>+<alt>+r
# Browser sign-in must complete within this many seconds.
DESKTOP_LOGIN_TIMEOUT_SECONDS=120
# macOS Keychain service namespace. Change it only to isolate installations.
KEYCHAIN_SERVICE_PREFIX=com.spaced-repetition-agent.desktop

# Optional: trace ingestion/chat graphs, model calls, and tools in LangSmith.
# Set true and supply your LangSmith key to enable uploads (includes study content).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spaced-repetition-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set for an API key linked to multiple workspaces:
# LANGSMITH_WORKSPACE_ID=your-workspace-id

# --- Phase 6: open-source packaging ---
# Set true ONLY on the hosted demo instance. Off by default for self-hosters.
DEMO_MODE=false
# Days of study data to retain on the hosted demo before the hourly reset job wipes it.
DEMO_DATA_RETENTION_DAYS=7
# How often the demo reset job runs (seconds). Default 3600 = once per hour.
DEMO_RESET_INTERVAL_S=3600
